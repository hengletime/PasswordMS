<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 扫码配对（F-09）：WebView 里 getUserMedia 需要相机权限。
         缺此声明时 wry 的运行时 requestPermissions 必被系统拒绝 → 前端收到 NotAllowedError。 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- D-131：局域网地址发现（`sync/discovery.rs` 的 UDP 广播）在 Android 上需要
         MulticastLock，而拿这个锁必须先声明本权限。缺它时 `WifiManager.createMulticastLock`
         抛 SecurityException —— 表现为「手机收不到电脑的广播」，即对端换 IP 后永远找不回来。
         `ACCESS_WIFI_STATE` 是普通权限（不弹授权框），部分 ROM 上访问 WifiManager 需要它一起声明。 -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- D-141（v1.5.0）：Android 17（API 37）起，targetSdk>=37 的应用访问局域网
         必须持有 ACCESS_LOCAL_NETWORK（NEARBY_DEVICES 运行时权限组），默认关闭。
         缺它时系统对该 UID 的 AppOps `ACCESS_LOCAL_NETWORK` 恒为 ignore（实测
         `adb shell cmd appops get com.passwordms.app` 可见 `Uid mode: ... ignore`），
         本应用的 TCP 连接/UDP 广播被**静默丢弃**（手机侧 `ss -tne` 卡在 SYN-SENT、
         无 RST），与本机防火墙、路由器、`netpolicy` 全部无关。
         低版本系统忽略此声明，不影响 Android 6~16。运行时申请见 MainActivity.kt。 -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <!-- AndroidTV support -->
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/full_backup_content"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.passwordms"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- AndroidTV support -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
