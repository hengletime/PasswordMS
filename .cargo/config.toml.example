# ===========================================================================
# PasswordMS · 本地构建配置模板
# ===========================================================================
# 用法：把本文件复制为同目录下的 `config.toml`，再把下面标注的
#       <占位符> 换成你自己机器上的真实路径。
#       `config.toml` 已被 .gitignore 排除，不会被提交（它是机器专属的）。
#
#   Windows:  copy .cargo\config.toml.example .cargo\config.toml
#   Linux/macOS:  cp .cargo/config.toml.example .cargo/config.toml
#
# ---------------------------------------------------------------------------
# 这个文件是干什么的
# ---------------------------------------------------------------------------
# 默认情况下 **不需要** 它。只有在「没有 MSVC / 没有完整 mingw-w64」的
# Windows 机器上编译，才需要按下面的办法绕行。有 Visual Studio Build Tools
# 的机器直接用默认目标即可：`cargo test -p passwordms-core`
#
# 背景（踩坑记录详见 docs/03b-verification.md §8）：
#   1. 无 MSVC 时只能走 windows-gnu 目标，而它的 getrandom 依赖走 raw-dylib，
#      编译期必须调用 dlltool 生成导入库；rustup 自带的 dlltool 找不到配套的
#      `as` 汇编器，此路不通。
#   2. 因此改用 rustup 自带的 `x86_64-pc-windows-gnullvm` 目标（LLVM ABI），
#      用工具链里的 rust-lld 当链接器，并手工补齐两个缺失的 CRT 符号。
#   3. 还需要 mingw-w64 的 `as.exe` / `dlltool.exe` / `windres.exe`（Tauri 嵌入
#      图标要用 windres）。这些不在 rustup 里，需自行准备。
# ---------------------------------------------------------------------------

[target.x86_64-pc-windows-gnullvm]
linker = "rust-lld"
rustflags = [
    # ↓↓↓ 把 <RUSTUP_TOOLCHAIN_ROOT> 换成你的 rustup 工具链根目录 ↓↓↓
    #     典型值（Windows）:  C:\Users\<你的用户名>\.rustup\toolchains\stable-x86_64-pc-windows-gnu
    #     典型值（Linux）  :  /home/<你的用户名>/.rustup/toolchains/stable-x86_64-unknown-linux-gnu
    #     不确定就先运行 `rustup show home` 看 .rustup 在哪。
    "-L", "native=<RUSTUP_TOOLCHAIN_ROOT>/lib/rustlib/x86_64-pc-windows-gnu/lib/self-contained",

    # ↓↓↓ 把你自备的 mingw-w64 静态库目录换成真实路径 ↓↓↓
    #     里面至少要能链接到 kernel32 / msvcrt 等基础导入库。
    #     若你装了完整的 mingw-w64，可以指向它的 <前缀>/x86_64-w64-mingw32/lib
    "-L", "native=<MINGW_W64_LIB_DIR>",

    "-C", "link-self-contained=yes",
]

# ⛔ 上面这组必须**再写一遍**给 rustdoc，否则 `cargo test --doc` 会炸（门禁命令 6 会假红）。
# doctest 必须单独再给一遍：cargo **不会**把 target.*.rustflags 转发给 rustdoc 起的
# 编译过程（rustdoc 自己再调 rustc 编 doctest，那条命令只吃 rustdocflags）。缺了它，
# 一旦有 `///` 下的 ``` 示例（doc 测试），链接就会报
#   lld: error: unable to find library -lkernel32/-lbcrypt/...   （缺 wsllibs 的导入库）
#   lld: error: <root>: undefined symbol: mainCRTStartup          （缺 link-self-contained）
# 2026-10-21 实测：本机只配 rustflags 时 doctest 链接失败（报错长得像工具链坏了，
# 极易误判成环境问题）；镜像下面三条后 `cargo test -p passwordms-core --doc --target
# x86_64-pc-windows-gnullvm` 1 passed ——
#   test crates\passwordms-core\src\attachment_name.rs - attachment_name::filename_from_source (line 50) ... ok
# ⚠ 两个列表的占位符是**同一组路径**，改一处必须同步另一处——它们是"同一件事的两次声明"。
rustdocflags = [
    # 与上方 rustflags 第一条完全相同（同一组 <占位符>，换成你机器上的真实路径）
    "-L", "native=<RUSTUP_TOOLCHAIN_ROOT>/lib/rustlib/x86_64-pc-windows-gnu/lib/self-contained",
    # 与上方 rustflags 第二条完全相同
    "-L", "native=<MINGW_W64_LIB_DIR>",
    "-C", "link-self-contained=yes",
]

# 关掉增量编译最省心：开着时，增量会话锁文件的清理会被「批量删除守卫」拦截
# （报 os error 5 拒绝访问），偶发把 cargo 卡死。
[build]
incremental = false

# ---------------------------------------------------------------------------
# 关于 `windres`（Tauri 嵌入图标 / manifest 用）—— **这里什么都不用配**
# ---------------------------------------------------------------------------
# 事故 D-33（2026-10-14）：只跑 `npx tauri build` 时炸在
#     tauri-winres-0.3.6/src/lib.rs:543
#     panicked ... NotAttempted("windres")
# 根因是 `tauri-winres` → `embed-resource 3.x` 在 Windows+GNU 宿主上把编译器探测
# 写死成 `Command::new("windres")`（只认 PATH），而本机没有 MSVC、也没有系统级
# mingw-w64，`windres` 只在用户自备目录里，且那条 `export PATH` 从未固化。
#
# **不要在 `.cargo/config.toml` 里用 `[env] PATH = { prepend = true }` 来修** ——
# 实测在 Windows 上对 build script 无效：系统注入的环境变量名是 `Path`，cargo 又把
# `PATH` 当新条目塞进去，两条并存，build script 读到的仍是旧值。同份 config 里的
# 自定义变量能传进 build script，**只有 PATH 传不进去**。
#
# 正解在 `src-tauri/build.rs` 的 `ensure_windres_on_path()`：PATH 上找不到
# `windres` 时自动按下面的顺序探测并把命中目录前置进本进程 PATH，
# 因此不依赖任何人工 export，也不依赖由哪个入口起构建。
#
#   1. 环境变量 `PMS_WINRES_DIR`  ← 换机器请设这个，指向含 windres.exe 的目录
#   2. `%USERPROFILE%\.workbuddy\tools\mingw-bin\`
#   3. `C:\msys64\mingw64\bin\` / `C:\mingw64\bin\`
#
# 装了完整 mingw-w64 或 Visual Studio Build Tools 的机器，PATH 上本来就有
# `windres`，无需任何设置（也就不需要本文件）。
#
# 详述与踩坑见 docs/03b-verification.md §8.1 / §8.2。
